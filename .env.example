# ==============================================================================
#  BugTrail Web · environment variables
# ------------------------------------------------------------------------------
#  Copy to `.env.local`:  cp .env.example .env.local   (Command Prompt: copy .env.example .env.local)
#  Three sections: DEVELOPMENT (active), STAGING and PRODUCTION (commented out).
#  Only one section may be active. NEXT_PUBLIC_ values are baked into the browser
#  bundle at build time: set them BEFORE `npm run build`, and never put a secret in one.
# ==============================================================================


# ##############################################################################
#  1. DEVELOPMENT · your machine (active)
# ##############################################################################

# Base URL of bugtrail-api, including /v1. Live updates (Socket.IO) use the same host.
NEXT_PUBLIC_API_URL=http://localhost:5000/v1


# ##############################################################################
#  2. STAGING · Railway, for testing (deploys from `development`)
#     Railway web service → Variables, without the "# ". Set before the first build;
#     changing it later needs a redeploy (rebuild), not just a restart.
# ##############################################################################

# NEXT_PUBLIC_API_URL=https://<staging-api-service>.up.railway.app/v1
#
# • The API's CLIENT_URL must be this web service's origin, or sign-in won't survive a reload.


# ##############################################################################
#  3. PRODUCTION · own VPS (deploys from `main`)
#     In the server's .env, without the "# ", before `npm run build`.
# ##############################################################################

# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/v1
#
# • The API's CLIENT_URL must be https://app.yourdomain.com.
